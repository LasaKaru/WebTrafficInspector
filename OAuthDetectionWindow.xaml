<Window x:Class="WebTrafficInspector.OAuthDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OAuth/OIDC Flow Detection and Attack"
        Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C97EA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3E3E42"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="OAuth 2.0 / OpenID Connect Flow Detection and Attack"
                          FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText"
                          Text="Ready to detect and attack OAuth flows"
                          FontSize="12"
                          Foreground="#00D000"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Detected Flows List -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Detected OAuth/OIDC Flows" FontWeight="Bold" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"/>
                            <Button x:Name="AttackSelectedButton" Content="Attack Selected" Click="AttackSelectedButton_Click"/>
                            <Button x:Name="AttackAllButton" Content="Attack All" Click="AttackAllButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                             x:Name="FlowsDataGrid"
                             SelectionChanged="FlowsDataGrid_SelectionChanged"
                             Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Flow ID" Binding="{Binding FlowId}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding FlowType}" Width="120"/>
                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding AttackStatus}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AttackStatus}" Value="Attacked">
                                                <Setter Property="Foreground" Value="#00D000"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AttackStatus}" Value="Vulnerable">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                         Background="#3E3E42"
                         HorizontalAlignment="Stretch"
                         ResizeBehavior="PreviousAndNext"/>

            <!-- Right Panel: Flow Details and Results -->
            <Border Grid.Column="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Flow Details and Attack Results" FontWeight="Bold" FontSize="14"/>

                    <TabControl Grid.Row="1"
                               x:Name="DetailsTabControl"
                               Background="#252526"
                               BorderBrush="#3E3E42"
                               Margin="0,10,0,0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </TabControl.Resources>

                        <!-- Flow Info Tab -->
                        <TabItem Header="Flow Info">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="OAuth Flow Information" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                                    <TextBlock Text="Flow ID:" FontWeight="Bold"/>
                                    <TextBox x:Name="FlowIdTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Flow Type:" FontWeight="Bold"/>
                                    <TextBox x:Name="FlowTypeTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Host:" FontWeight="Bold"/>
                                    <TextBox x:Name="HostTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Authorization Endpoint:" FontWeight="Bold"/>
                                    <TextBox x:Name="AuthEndpointTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Client ID:" FontWeight="Bold"/>
                                    <TextBox x:Name="ClientIdTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Redirect URI:" FontWeight="Bold"/>
                                    <TextBox x:Name="RedirectUriTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Scope:" FontWeight="Bold"/>
                                    <TextBox x:Name="ScopeTextBox" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="State Parameter:" FontWeight="Bold"/>
                                    <TextBox x:Name="StateTextBox" IsReadOnly="True" Margin="0,0,0,10"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Request Tab -->
                        <TabItem Header="Request">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="OAuth Request" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                    <TextBox x:Name="RequestTextBox"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            VerticalScrollBarVisibility="Auto"
                                            Height="500"
                                            IsReadOnly="True"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Response Tab -->
                        <TabItem Header="Response">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="OAuth Response" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                    <TextBox x:Name="ResponseTextBox"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            VerticalScrollBarVisibility="Auto"
                                            Height="500"
                                            IsReadOnly="True"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Vulnerabilities Tab -->
                        <TabItem Header="Vulnerabilities">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Detected Vulnerabilities" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                                <DataGrid Grid.Row="1"
                                         x:Name="VulnerabilitiesDataGrid"
                                         SelectionChanged="VulnerabilitiesDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="High">
                                                            <Setter Property="Foreground" Value="Orange"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                            <Setter Property="Foreground" Value="Yellow"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" Text="Vulnerability Details" FontWeight="Bold" FontSize="12" Margin="0,10,0,5"/>

                                <TextBox Grid.Row="3"
                                        x:Name="VulnerabilityDetailsTextBox"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        IsReadOnly="True"/>
                            </Grid>
                        </TabItem>

                        <!-- Attack Results Tab -->
                        <TabItem Header="Attack Results">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Attack Results" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                    <TextBox x:Name="AttackResultsTextBox"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            VerticalScrollBarVisibility="Auto"
                                            Height="500"
                                            IsReadOnly="True"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Panel: Action Buttons -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GenerateReportButton" Content="Generate Report" Click="GenerateReportButton_Click"/>
                <Button x:Name="ExportResultsButton" Content="Export Results" Click="ExportResultsButton_Click"/>
                <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
