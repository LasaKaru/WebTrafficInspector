<Window x:Class="WebTrafficInspector.Windows.AttackResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auto Attack Mode - Results" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Auto Attack Mode - Live Results"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="txtTargetUrl"
                               Text="Target: N/A"
                               FontSize="12"
                               Foreground="#ECF0F1"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#27AE60" CornerRadius="3" Padding="10,5" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status: " Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="txtStatus" Text="Idle" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Panel -->
        <Border Grid.Row="1" Background="#ECF0F1" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Attacks" FontSize="10" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="txtTotalAttacks" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Vulnerabilities" FontSize="10" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="txtVulnerabilities" Text="0" FontSize="24" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Total Tests" FontSize="10" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="txtTotalTests" Text="0" FontSize="24" FontWeight="Bold" Foreground="#3498DB"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="URLs Tested" FontSize="10" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="txtUrlsTested" Text="0" FontSize="24" FontWeight="Bold" Foreground="#9B59B6"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Avg Duration" FontSize="10" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="txtAvgDuration" Text="0s" FontSize="24" FontWeight="Bold" Foreground="#16A085"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="2" Margin="5">
            <!-- Live Results Tab -->
            <TabItem Header="Live Results">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Filter by Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbFilterType" Width="150" SelectionChanged="FilterType_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="XSS"/>
                            <ComboBoxItem Content="SQL Injection"/>
                            <ComboBoxItem Content="IDOR"/>
                        </ComboBox>
                        <CheckBox x:Name="chkOnlyVulnerable" Content="Show only vulnerable"
                                  Margin="15,0,0,0" VerticalAlignment="Center"
                                  Checked="FilterType_SelectionChanged"
                                  Unchecked="FilterType_SelectionChanged"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgResults"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="dgResults_SelectionChanged"
                              RowBackground="White"
                              AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                            <DataGridTextColumn Header="Attack Type" Binding="{Binding AttackType}" Width="120"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding TargetUrl}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                            <DataGridTextColumn Header="Vulnerabilities" Binding="{Binding VulnerabilitiesFound}" Width="100"/>
                            <DataGridTextColumn Header="Tests" Binding="{Binding TotalTests}" Width="70"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat='{}{0:F2}s'}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Detailed Results Tab -->
            <TabItem Header="Details">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select an attack from Live Results to view details"
                               Margin="10" FontStyle="Italic" Foreground="#7F8C8D"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="txtDetails"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 Background="#F8F9FA"
                                 Padding="10"
                                 BorderThickness="0"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Statistics Tab -->
            <TabItem Header="Statistics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Attack Type Distribution"
                                   FontSize="16" FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgAttackTypeStats"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="150"
                                  Margin="0,0,0,20">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Attack Type" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Value}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Most Vulnerable URLs"
                                   FontSize="16" FontWeight="Bold"
                                   Margin="0,10,0,10"/>
                        <DataGrid x:Name="dgVulnerableUrls"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                                <DataGridTextColumn Header="Vulnerabilities" Binding="{Binding TotalVulnerabilities}" Width="120"/>
                                <DataGridTextColumn Header="Attack Types" Binding="{Binding AttackTypesString}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Activity Log Tab -->
            <TabItem Header="Activity Log">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="txtActivityLog"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#F8F9FA"
                             Padding="10"
                             BorderThickness="0"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Toolbar -->
        <Border Grid.Row="3" Background="#ECF0F1" Padding="10" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnExportReport"
                        Content="Export Report"
                        Width="120"
                        Padding="10,5"
                        Margin="5,0"
                        Click="btnExportReport_Click"/>
                <Button x:Name="btnClearResults"
                        Content="Clear Results"
                        Width="120"
                        Padding="10,5"
                        Margin="5,0"
                        Click="btnClearResults_Click"/>
                <Button x:Name="btnRefresh"
                        Content="Refresh"
                        Width="100"
                        Padding="10,5"
                        Margin="5,0"
                        Click="btnRefresh_Click"/>
                <Button x:Name="btnClose"
                        Content="Close"
                        Width="100"
                        Padding="10,5"
                        Margin="5,0"
                        Click="btnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
