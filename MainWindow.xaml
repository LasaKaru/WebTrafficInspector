<Window x:Class="WebTrafficInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Web Traffic Inspector" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <Window.Resources>
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="TextBox" x:Key="MonospaceTextBox">
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Background" Value="#F8F8F8"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu Bar -->
            <RowDefinition Height="Auto"/>
            <!-- URL Bar -->
            <RowDefinition Height="2*"/>
            <!-- WebView2 Browser -->
            <RowDefinition Height="5"/>
            <!-- Splitter -->
            <RowDefinition Height="2*"/>
            <!-- Traffic Log -->
            <RowDefinition Height="5"/>
            <!-- Splitter -->
            <RowDefinition Height="1.5*"/>
            <!-- Request/Response Pane -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Session" Click="NewSession_Click" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <TextBlock Text="📄" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open Session..." Click="OpenSession_Click" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Save Session" Click="SaveSession_Click" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save Session _As..." Click="SaveSessionAs_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="Recent Sessions" Name="RecentSessionsMenu">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Export">
                    <MenuItem Header="Export as _JSON..." Click="ExportJson_Click"/>
                    <MenuItem Header="Export as _CSV..." Click="ExportCsv_Click"/>
                    <MenuItem Header="Export as _XML..." Click="ExportXml_Click"/>
                </MenuItem>
                <MenuItem Header="_Import">
                    <MenuItem Header="Import from _JSON..." Click="ImportJson_Click"/>
                    <MenuItem Header="Import from _Burp Suite..." Click="ImportBurp_Click"/>
                    <MenuItem Header="Import from _Fiddler..." Click="ImportFiddler_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>

            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="_Traffic Log" IsCheckable="True" IsChecked="True" Click="ToggleTrafficLog_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📊" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Request/Response Pane" IsCheckable="True" IsChecked="True" Click="ToggleRequestResponse_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📑" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Browser Pane" IsCheckable="True" IsChecked="True" Click="ToggleBrowser_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🌐" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Filter Traffic">
                    <MenuItem Header="Show _All" IsCheckable="True" IsChecked="True" Click="FilterAll_Click"/>
                    <MenuItem Header="Show _HTTP Only" IsCheckable="True" Click="FilterHttp_Click"/>
                    <MenuItem Header="Show _HTTPS Only" IsCheckable="True" Click="FilterHttps_Click"/>
                    <MenuItem Header="Show _Errors Only" IsCheckable="True" Click="FilterErrors_Click"/>
                </MenuItem>
                <MenuItem Header="_Columns">
                    <MenuItem Header="Show _Method" IsCheckable="True" IsChecked="True" Click="ToggleMethodColumn_Click"/>
                    <MenuItem Header="Show _Status" IsCheckable="True" IsChecked="True" Click="ToggleStatusColumn_Click"/>
                    <MenuItem Header="Show _Length" IsCheckable="True" IsChecked="True" Click="ToggleLengthColumn_Click"/>
                    <MenuItem Header="Show _Time" IsCheckable="True" IsChecked="True" Click="ToggleTimeColumn_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Themes">
                    <MenuItem Header="_Light Theme" IsCheckable="True" IsChecked="True" Click="SetLightTheme_Click"/>
                    <MenuItem Header="_Dark Theme" IsCheckable="True" Click="SetDarkTheme_Click"/>
                    <MenuItem Header="_Auto (System)" IsCheckable="True" Click="SetAutoTheme_Click"/>
                </MenuItem>
                <MenuItem Header="_Zoom">
                    <MenuItem Header="Zoom _In" Click="ZoomIn_Click" InputGestureText="Ctrl++"/>
                    <MenuItem Header="Zoom _Out" Click="ZoomOut_Click" InputGestureText="Ctrl+-"/>
                    <MenuItem Header="_Reset Zoom" Click="ResetZoom_Click" InputGestureText="Ctrl+0"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Full Screen" Click="ToggleFullScreen_Click" InputGestureText="F11"/>
                <MenuItem Header="_Always on Top" IsCheckable="True" Click="ToggleAlwaysOnTop_Click"/>
            </MenuItem>

            <!--Edit Menu -->
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z">
                    <MenuItem.Icon>
                        <TextBlock Text="↶" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y">
                    <MenuItem.Icon>
                        <TextBlock Text="↷" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Cu_t" Click="Cut_Click" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy" Click="Copy_Click" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste" Click="Paste_Click" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="Select _All" Click="SelectAll_Click" InputGestureText="Ctrl+A"/>
                <MenuItem Header="_Deselect All" Click="DeselectAll_Click"/>
            </MenuItem>

            <!-- Tools Menu -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Proxy Settings..." Click="ProxySettings_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Certificate Manager..." Click="CertificateManager_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔒" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Move and Organize">
                    <MenuItem.Icon>
                        <TextBlock Text="🔀" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Basic Move">
                        <MenuItem Header="Move Up" Click="MoveUp_Click" InputGestureText="Ctrl+Up"/>
                        <MenuItem Header="Move Down" Click="MoveDown_Click" InputGestureText="Ctrl+Down"/>
                        <MenuItem Header="Move to Top" Click="MoveToTop_Click" InputGestureText="Ctrl+Home"/>
                        <MenuItem Header="Move to Bottom" Click="MoveToBottom_Click" InputGestureText="Ctrl+End"/>
                        <MenuItem Header="Move to Position..." Click="MoveToPosition_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Reorder by">
                        <MenuItem Header="Sort by Time (Ascending)" Click="SortByTimeAsc_Click"/>
                        <MenuItem Header="Sort by Time (Descending)" Click="SortByTimeDesc_Click"/>
                        <MenuItem Header="Group by Host" Click="GroupByHost_Click"/>
                        <MenuItem Header="Group by Method" Click="GroupByMethod_Click"/>
                        <MenuItem Header="Group by Status" Click="GroupByStatus_Click"/>
                        <MenuItem Header="Reverse Order" Click="ReverseOrder_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Smart Move">
                        <MenuItem Header="Move by Host..." Click="MoveByHost_Click"/>
                        <MenuItem Header="Move by Status Code..." Click="MoveByStatus_Click"/>
                        <MenuItem Header="Move by Method..." Click="MoveByMethod_Click"/>
                        <MenuItem Header="Move by Time Range..." Click="MoveByTimeRange_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Pin/Unpin">
                        <MenuItem Header="Pin Selected" Click="PinSelected_Click"/>
                        <MenuItem Header="Unpin Selected" Click="UnpinSelected_Click"/>
                        <MenuItem Header="Move Pinned to Top" Click="MovePinnedToTop_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Extract to New Session..." Click="ExtractToSession_Click"/>
                </MenuItem>
                <MenuItem Header="_Tags and Labels">
                    <MenuItem.Icon>
                        <TextBlock Text="🏷️" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Add Tags..." Click="AddTags_Click"/>
                    <MenuItem Header="Remove Tags..." Click="RemoveTags_Click"/>
                    <MenuItem Header="Filter by Tags..." Click="FilterByTags_Click"/>
                    <Separator/>
                    <MenuItem Header="Set Color Highlight..." Click="SetColor_Click"/>
                    <MenuItem Header="Clear Color Highlight" Click="ClearColor_Click"/>
                </MenuItem>
                <MenuItem Header="_Duplicates">
                    <MenuItem.Icon>
                        <TextBlock Text="🔍" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Find Duplicates..." Click="FindDuplicates_Click"/>
                    <MenuItem Header="Remove Duplicates..." Click="RemoveDuplicates_Click"/>
                </MenuItem>
                <MenuItem Header="_Sessions">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Merge Sessions..." Click="MergeSessions_Click"/>
                    <MenuItem Header="Split Session">
                        <MenuItem Header="Split by Host..." Click="SplitByHost_Click"/>
                        <MenuItem Header="Split by Status Category..." Click="SplitByStatus_Click"/>
                        <MenuItem Header="Split by Time Interval..." Click="SplitByTime_Click"/>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Request Replayer">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Replay Selected Request..." Click="ReplayRequest_Click"/>
                    <MenuItem Header="Replay with Modifications..." Click="ReplayModified_Click"/>
                    <MenuItem Header="Batch Replay..." Click="BatchReplay_Click"/>
                    <MenuItem Header="Fuzzing Mode..." Click="FuzzReplay_Click"/>
                </MenuItem>
                <MenuItem Header="_Encoding/Decoding">
                    <MenuItem.Icon>
                        <TextBlock Text="🔐" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Encoder/Decoder Tool..." Click="EncoderDecoder_Click"/>
                    <MenuItem Header="JWT Decoder..." Click="JwtDecoder_Click"/>
                    <MenuItem Header="Hash Calculator..." Click="HashCalculator_Click"/>
                    <MenuItem Header="Auto-Decode..." Click="AutoDecode_Click"/>
                </MenuItem>
                <MenuItem Header="_JWT Tools">
                    <MenuItem.Icon>
                        <TextBlock Text="🔑" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Analyze JWT..." Click="AnalyzeJWT_Click"/>
                    <MenuItem Header="Generate Attack Variants..." Click="GenerateJWTAttacks_Click"/>
                </MenuItem>
                <MenuItem Header="_GraphQL Tools">
                    <MenuItem.Icon>
                        <TextBlock Text="📊" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Analyze GraphQL Request..." Click="AnalyzeGraphQL_Click"/>
                </MenuItem>
                <MenuItem Header="_Intruder/Fuzzer">
                    <MenuItem.Icon>
                        <TextBlock Text="💥" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Launch Intruder..." Click="LaunchIntruder_Click"/>
                </MenuItem>
                <MenuItem Header="_Pattern Matcher">
                    <MenuItem.Icon>
                        <TextBlock Text="🎯" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Search Pattern..." Click="SearchPattern_Click"/>
                    <MenuItem Header="Extract Common Patterns">
                        <MenuItem Header="Extract Emails" Click="ExtractEmails_Click"/>
                        <MenuItem Header="Extract URLs" Click="ExtractUrls_Click"/>
                        <MenuItem Header="Extract IPs" Click="ExtractIPs_Click"/>
                        <MenuItem Header="Extract API Keys" Click="ExtractAPIKeys_Click"/>
                        <MenuItem Header="Extract JWTs" Click="ExtractJWTs_Click"/>
                    </MenuItem>
                    <MenuItem Header="Extract Parameters..." Click="ExtractParameters_Click"/>
                    <MenuItem Header="Extract Headers..." Click="ExtractHeaders_Click"/>
                    <MenuItem Header="Extract Cookies..." Click="ExtractCookies_Click"/>
                    <MenuItem Header="List Endpoints..." Click="ListEndpoints_Click"/>
                </MenuItem>
                <MenuItem Header="_Security Analyzer">
                    <MenuItem.Icon>
                        <TextBlock Text="🛡️" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Analyze Selected Entry..." Click="AnalyzeSecurity_Click"/>
                    <MenuItem Header="Analyze Entire Session..." Click="AnalyzeSession_Click"/>
                    <MenuItem Header="Security Headers Check..." Click="SecurityHeaders_Click"/>
                    <MenuItem Header="Find Vulnerabilities..." Click="FindVulnerabilities_Click"/>
                    <MenuItem Header="Detect Injections..." Click="DetectInjections_Click"/>
                    <MenuItem Header="Find Sensitive Data..." Click="FindSensitiveData_Click"/>
                    <MenuItem Header="Generate Security Report..." Click="GenerateSecurityReport_Click"/>
                    <Separator/>
                    <MenuItem Header="Auto Attack Mode">
                        <MenuItem.Icon>
                            <TextBlock Text="⚡" FontSize="14"/>
                        </MenuItem.Icon>
                        <MenuItem Header="Toggle Auto Attack Mode" Click="ToggleAutoAttackMode_Click"/>
                        <MenuItem Header="Show Attack Results..." Click="ShowAttackResults_Click"/>
                        <MenuItem Header="Load XSS Payloads..." Click="LoadXSSPayloads_Click"/>
                        <MenuItem Header="Configure..." Click="ConfigureAutoAttack_Click"/>
                    </MenuItem>
                    <MenuItem Header="OAuth/OIDC Detection">
                        <MenuItem.Icon>
                            <TextBlock Text="🔐" FontSize="14"/>
                        </MenuItem.Icon>
                        <MenuItem Header="Show OAuth Detection Window..." Click="ShowOAuthDetectionWindow_Click"/>
                        <MenuItem Header="Toggle Popup Notifications" Click="ToggleOAuthNotifications_Click"/>
                    </MenuItem>
                    <MenuItem Header="OWASP Top 10 2025 Scanner">
                        <MenuItem.Icon>
                            <TextBlock Text="🛡️" FontSize="14"/>
                        </MenuItem.Icon>
                        <MenuItem Header="Show OWASP Scanner Window..." Click="ShowOWASPScanWindow_Click"/>
                        <MenuItem Header="Toggle Automatic Scanning" Click="ToggleOWASPScanning_Click"/>
                        <MenuItem Header="Export HTML Report..." Click="ExportOWASPReport_Click"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Comparison Tool">
                    <MenuItem.Icon>
                        <TextBlock Text="⚖️" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Compare Two Entries..." Click="CompareEntries_Click"/>
                    <MenuItem Header="Compare Requests..." Click="CompareRequests_Click"/>
                    <MenuItem Header="Compare Responses..." Click="CompareResponses_Click"/>
                    <MenuItem Header="Compare Sessions..." Click="CompareSessions_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Search Traffic..." Click="SearchTraffic_Click" InputGestureText="Ctrl+F">
                    <MenuItem.Icon>
                        <TextBlock Text="🔍" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Advanced Filter..." Click="AdvancedFilter_Click" InputGestureText="Ctrl+Shift+F"/>
                <MenuItem Header="_Clear All Filters" Click="ClearFilters_Click"/>
                <Separator/>
                <MenuItem Header="_Request Builder..." Click="RequestBuilder_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔧" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Response Analyzer..." Click="ResponseAnalyzer_Click"/>
                <MenuItem Header="_Traffic Statistics..." Click="TrafficStats_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📈" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Export">
                    <MenuItem.Icon>
                        <TextBlock Text="📤" FontSize="14"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Export to HAR..." Click="ExportHAR_Click"/>
                    <MenuItem Header="Export to JSON..." Click="ExportJSON_Click"/>
                    <MenuItem Header="Export to CSV..." Click="ExportCSV_Click"/>
                    <MenuItem Header="Export to XML..." Click="ExportXML_Click"/>
                    <MenuItem Header="Export to Markdown..." Click="ExportMarkdown_Click"/>
                    <Separator/>
                    <MenuItem Header="Generate HTML Security Report..." Click="GenerateHTMLReport_Click"/>
                    <MenuItem Header="Export to Burp Format..." Click="ExportBurp_Click"/>
                    <MenuItem Header="Export Security Report (HTML)..." Click="ExportSecurityHTML_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Options..." Click="Options_Click" InputGestureText="Ctrl+,">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="_User Guide" Click="UserGuide_Click" InputGestureText="F1">
                    <MenuItem.Icon>
                        <TextBlock Text="❓" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Quick Start Tutorial" Click="QuickStart_Click"/>
                <MenuItem Header="_Keyboard Shortcuts" Click="KeyboardShortcuts_Click"/>
                <Separator/>
                <MenuItem Header="_Video Tutorials" Click="VideoTutorials_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎥" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Online Documentation" Click="OnlineDocumentation_Click"/>
                <MenuItem Header="_Community Forum" Click="CommunityForum_Click"/>
                <Separator/>
                <MenuItem Header="_Report Bug..." Click="ReportBug_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🐛" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Feature Request..." Click="FeatureRequest_Click"/>
                <MenuItem Header="_Contact Support..." Click="ContactSupport_Click"/>
                <Separator/>
                <MenuItem Header="💝 _Support Development" Click="SupportDevelopment_Click" FontWeight="Bold" Foreground="#FF4CAF50">
                    <MenuItem.Icon>
                        <TextBlock Text="❤️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Check for Updates..." Click="CheckUpdates_Click"/>
                <Separator/>
                <MenuItem Header="_About Web Traffic Inspector" Click="About_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- URL Bar -->
        <Border Grid.Row="1" Background="#F0F0F0" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Go" Width="60" Margin="5,0,0,0" 
                        Click="NavigateButton_Click" Background="#4CAF50" Foreground="White" 
                        Style="{StaticResource ToolbarButton}"/>
                <Button DockPanel.Dock="Right" Content="New Window" Width="100" Margin="5,0,0,0"
                        Click="NewWindowButton_Click" Background="#2196F3" Foreground="White"
                        Style="{StaticResource ToolbarButton}"/>
                <TextBox Name="UrlTextBox" VerticalContentAlignment="Center" Padding="8"
                         KeyDown="UrlTextBox_KeyDown" Text="https://httpbin.org/get"
                         FontSize="12" BorderBrush="#CCCCCC" BorderThickness="1"/>
            </DockPanel>
        </Border>

        <!-- WebView2 Browser -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Margin="5">
            <Grid>
                <wv2:WebView2 Name="WebViewControl"/>
                <!-- Loading overlay -->
                <Border Name="BrowserLoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading browser..." FontSize="14" Foreground="#666666"/>
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Horizontal Splitter -->
        <GridSplitter Grid.Row="3" Height="5" ResizeDirection="Rows" Background="#E0E0E0"/>

        <!-- Traffic Log -->
        <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E8E8E8" Padding="8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="Captured Traffic" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                            <Button Content="Clear" Margin="15,0,0,0" Click="ClearButton_Click" 
                                    Background="#FF5722" Foreground="White" BorderThickness="0" 
                                    Padding="8,3" FontSize="11"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Name="FilterText" Text="" Margin="10,0" VerticalAlignment="Center" 
                                       FontStyle="Italic" FontSize="11" Foreground="#666666"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid Grid.Row="1" Name="TrafficDataGrid" AutoGenerateColumns="False"
                          SelectionMode="Extended" SelectionChanged="TrafficDataGrid_SelectionChanged"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowHeaderWidth="0" CanUserAddRows="False" IsReadOnly="True"
                          AlternatingRowBackground="#F9F9F9" FontSize="11"
                          AllowDrop="True" PreviewMouseLeftButtonDown="TrafficDataGrid_PreviewMouseLeftButtonDown"
                          Drop="TrafficDataGrid_Drop" DragOver="TrafficDataGrid_DragOver">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Cut" Click="Cut_Click" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy" Click="Copy_Click" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste" Click="Paste_Click" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="Move Up" Click="MoveUp_Click" InputGestureText="Ctrl+Up">
                                <MenuItem.Icon>
                                    <TextBlock Text="⬆️" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Move Down" Click="MoveDown_Click" InputGestureText="Ctrl+Down">
                                <MenuItem.Icon>
                                    <TextBlock Text="⬇️" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Move to Top" Click="MoveToTop_Click" InputGestureText="Ctrl+Home">
                                <MenuItem.Icon>
                                    <TextBlock Text="⏫" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Move to Bottom" Click="MoveToBottom_Click" InputGestureText="Ctrl+End">
                                <MenuItem.Icon>
                                    <TextBlock Text="⏬" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Move to Position..." Click="MoveToPosition_Click"/>
                            <Separator/>
                            <MenuItem Header="Pin/Unpin">
                                <MenuItem Header="Pin Selected" Click="PinSelected_Click"/>
                                <MenuItem Header="Unpin Selected" Click="UnpinSelected_Click"/>
                            </MenuItem>
                            <MenuItem Header="Tags">
                                <MenuItem Header="Add Tags..." Click="AddTags_Click"/>
                                <MenuItem Header="Remove Tags..." Click="RemoveTags_Click"/>
                            </MenuItem>
                            <MenuItem Header="Set Color..." Click="SetColor_Click"/>
                            <Separator/>
                            <MenuItem Header="Copy Data">
                                <MenuItem Header="Copy Raw Request" Click="CopyRequest_Click"/>
                                <MenuItem Header="Copy Raw Response" Click="CopyResponse_Click"/>
                                <MenuItem Header="Copy URL" Click="CopyUrl_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Delete Selected" Click="DeleteSelected_Click" InputGestureText="Delete">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗑️" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Extract to New Session..." Click="ExtractToSession_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📤" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" CanUserResize="False"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="80"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70"/>
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="200"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="200"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/>
                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="200">
                                    <Setter Property="Foreground" Value="#000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="204">
                                    <Setter Property="Foreground" Value="#000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="401">
                                    <Setter Property="Foreground" Value="#FF5722"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="404">
                                    <Setter Property="Foreground" Value="#FF5722"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="500">
                                    <Setter Property="Foreground" Value="#F44336"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Horizontal Splitter -->
        <GridSplitter Grid.Row="5" Height="5" ResizeDirection="Rows" Background="#E0E0E0"/>

        <!-- Request/Response Pane -->
        <Border Grid.Row="6" BorderBrush="#CCCCCC" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Request Pane -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E3F2FD" Padding="8" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Request" FontWeight="Bold" FontSize="12"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📋" ToolTip="Copy Request" FontSize="10" Padding="4,2" 
                                        Background="Transparent" BorderThickness="0" Margin="5,0,0,0"/>
                                <Button Content="💾" ToolTip="Save Request" FontSize="10" Padding="4,2" 
                                        Background="Transparent" BorderThickness="0" Margin="5,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBox Grid.Row="1" Name="RequestTextBox" Style="{StaticResource MonospaceTextBox}"/>
                </Grid>

                <!-- Vertical Splitter -->
                <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#E0E0E0"/>

                <!-- Response Pane -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8F5E8" Padding="8" BorderBrush="#C8E6C9" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Response" FontWeight="Bold" FontSize="12"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📋" ToolTip="Copy Response" FontSize="10" Padding="4,2" 
                                        Background="Transparent" BorderThickness="0" Margin="5,0,0,0"/>
                                <Button Content="💾" ToolTip="Save Response" FontSize="10" Padding="4,2" 
                                        Background="Transparent" BorderThickness="0" Margin="5,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBox Grid.Row="1" Name="ResponseTextBox" Style="{StaticResource MonospaceTextBox}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="7" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Name="ProxyStatusIndicator" Fill="#4CAF50" Margin="0,0,5,0"/>
                    <TextBlock Name="StatusText" Text="Ready" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="SessionNameText" Text="Untitled Session" Margin="0,0,15,0" FontSize="11"/>
                    <TextBlock Name="TrafficCountText" Text="Traffic: 0" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
